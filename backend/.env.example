ODDS_API_KEY=your_theoddsapi_key_here
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here
PORT=5001

# Prediction store backups (backend/services/backupService.js). All optional:
# a nightly SQLite copy is kept on the volume either way (last BACKUP_KEEP, default 7)
# and the latest can be downloaded with GET /api/performance/backup (x-admin-key).
# BACKUP_HOUR_UTC=9
# BACKUP_KEEP=7
# BACKUP_WEBHOOK_URL=            # POST the backup file here (Authorization: Bearer BACKUP_WEBHOOK_TOKEN)
# BACKUP_WEBHOOK_TOKEN=
# BLOB_READ_WRITE_TOKEN=         # Vercel Blob: uploads to backups/<file>
# BACKUP_S3_BUCKET=              # S3 / R2 / B2: with AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ENDPOINT=            # e.g. https://<account>.r2.cloudflarestorage.com (omit for AWS)
# BACKUP_S3_PREFIX=predictions/
